<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Semsey Technologies</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0a0a0c" />
  <link rel="manifest" href="manifest.json" />
  <link rel="icon" type="image/png" href="images/logo/logo.png" />
  <link rel="apple-touch-icon" href="images/logo/logo.png" />

  <!-- Modular CSS -->
  <link rel="stylesheet" href="assets/theme/theme.css">
  <link rel="stylesheet" href="assets/theme/hero.css">
  <link rel="stylesheet" href="assets/theme/animations.css">
  <style>
    /* Allow links inside footer to be interactive even when footer is non-interactive */
    footer a { pointer-events: auto; color: inherit; text-decoration: underline; }

    /* Floating, subtle donate/support button */
    .donate-button {
      position: fixed;
      right: 20px;
      bottom: 84px; /* above footer */
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(47,139,255,0.12);
      color: var(--fg);
      border: 1px solid rgba(47,139,255,0.25);
      text-decoration: none;
      font-weight: 600;
      backdrop-filter: blur(6px);
      z-index: 998;
      transition: transform .15s ease, box-shadow .15s ease;
    }
    .donate-button:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(47,139,255,0.12); }
  </style>

  <!-- THEME ENGINE -->
  <script type="module">
    import {
      applyLogoSource,
      applyCogSource,
      applySavedTheme,
      applySavedNav
    } from "./assets/theme/theme.js";

    // Immediate application to prevent flash of unstyled content
    applySavedTheme();

    document.addEventListener("DOMContentLoaded", () => {
      applyLogoSource();
      applyCogSource();
      applySavedNav();
    });
  </script>
</head>

<body class="hero-body">

  <!-- Background Motion Layer -->
  <div id="bgLayer"></div>

  <!-- Settings Cog (variable-driven image, continuous spin) -->
  <a href="settings.html" class="settings-cog"></a>

  <div class="sidebar">
    <a href="index.html" class="active">Home</a>
    <a href="about.html">About</a>
    <a href="projects.html">Projects</a>
    <a href="contact.html">Contact</a>
    <a href="settings.html">Settings</a>
  </div>

  <main class="hero">
    <div class="logo">
      <!-- Logo source is set by theme.js using --logo-src -->
      <img id="siteLogo" src="" alt="Semsey Technologies Logo">
    </div>

    <div class="tagline">
      I build systems, theories, and tools — and I release them freely.
    </div>

    <div class="subtagline">
      Open‑source · Non‑restrictive · Pay‑what‑you‑want
    </div>

    <div class="buttons">
      <a href="about.html" class="btn">About</a>
      <a href="projects.html" class="btn">Projects</a>
      <button id="installBtn" class="btn" style="display: none;">Add to Device</button>
    </div>
  </main>

  <!-- True footer -->
  <footer>
    © 2026 Semsey Technologies — <a href="donate.html">Support</a>
  </footer>

  <!-- Floating donate button -->
  <a href="donate.html" class="donate-button" target="_blank" rel="noopener" aria-label="Support Semsey Technologies">💖 Support</a>
  </main>

  <script>
    let deferredPrompt;
    const installBtn = document.getElementById('installBtn');

    window.addEventListener('beforeinstallprompt', (e) => {
      // Prevent the mini-infobar from appearing on mobile
      e.preventDefault();
      // Stash the event so it can be triggered later.
      deferredPrompt = e;
      // Update UI notify the user they can install the PWA
      installBtn.style.display = 'block';
    });

    installBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        // Show the install prompt
        deferredPrompt.prompt();
        // Wait for the user to respond to the prompt
        const { outcome } = await deferredPrompt.userChoice;
        console.log(`User response to the install prompt: ${outcome}`);
        // We've used the prompt, and can't use it again, throw it away
        deferredPrompt = null;
        // Hide the button
        installBtn.style.display = 'none';
      }
    });

    window.addEventListener('appinstalled', (event) => {
      console.log('👍', 'appinstalled', event);
      // Clear the deferredPrompt so it can be garbage collected
      deferredPrompt = null;
      // Hide the install button
      installBtn.style.display = 'none';
    });
  </script>

  <footer>
    © 2026 Semsey Technologies
  </footer>

  <!-- Logo + Cog Loader removed (moved to head) -->
</body>
</html>
