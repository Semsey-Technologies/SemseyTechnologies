@app.post("/api/download/control")
def control_download_task(data: dict):
    task_id = data.get("task_id")
    action = data.get("action") # start, pause, resume, stop, retry
    if task_id not in download_tasks:
        raise HTTPException(status_code=404, detail="Task not found")
    task = download_tasks[task_id]

    if action == "pause":
        task["status"] = "paused"
        task["progress"] = "Paused"
    elif action == "resume":
        task["status"] = "queued"
        task["progress"] = "Queued (Resumed)"
    elif action == "stop":
        task["status"] = "stopped"
        task["progress"] = "Stopped by user"
    elif action == "retry":
        task["status"] = "queued"
        task["progress"] = "Queued (Retrying)"
    return {"status": "success"}

@app.post("/api/download/control-all")
def control_all_downloads(data: dict):
    action = data.get("action") # stop_all, start_all/resume_all, clear_queue, retry_failed
    global download_status, download_tasks

    if action == "stop_all":
        for task in download_tasks.values():
            if task["status"] in ["downloading", "queued", "paused"]:
                task["status"] = "stopped"
                task["progress"] = "Stopped by user"
        download_status["active"] = False
        download_status["progress"] = "Idle"
        return {"status": "success", "message": "All downloads stopped"}

    elif action in ["start_all", "resume_all"]:
        for task in download_tasks.values():
            if task["status"] in ["stopped", "paused", "failed"]:
                task["status"] = "queued"
                task["progress"] = "Queued"
        return {"status": "success", "message": "All downloads queued"}

    elif action == "clear_queue":
        download_tasks.clear()
        download_status["active"] = False
        download_status["progress"] = "Idle"
        return {"status": "success", "message": "Queue cleared"}

    elif action == "retry_failed":
        for task in download_tasks.values():
            if task["status"] == "failed":
                task["status"] = "queued"
                task["progress"] = "Queued (Retrying)"
        return {"status": "success", "message": "Retrying failed downloads"}

    raise HTTPException(status_code=400, detail="Invalid action")

