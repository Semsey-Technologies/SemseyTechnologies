@app.get("/api/media/library")
def get_media_library():
    movies = []
    tv_shows = {}

    for base_dir in MEDIA_PATHS:
        if os.path.exists(base_dir):
            for root, dirs, files in os.walk(base_dir):
                for file in files:
                    if file.lower().endswith(('.mp4', '.mkv', '.avi', '.mov', '.mp3', '.m4a', '.flv', '.webm')):
                        full_path = os.path.join(root, file)
                        import re
                        tv_match = re.search(r'(.*?)[sS](\d+)[eE](\d+)', file)
                        if tv_match or "tv" in root.lower() or "shows" in root.lower():
                            if tv_match:
                                show_name = tv_match.group(1).replace('.', ' ').strip()
                                season = int(tv_match.group(2))
                                episode = int(tv_match.group(3))
                            else:
                                rel = os.path.relpath(root, base_dir)
                                parts = rel.split(os.sep)
                                show_name = parts[0] if parts and parts[0] != '.' else "TV Shows"
                                season = 1
                                episode = 1

                            if show_name not in tv_shows:
                                tv_shows[show_name] = []
                            tv_shows[show_name].append({
                                "title": file,
                                "season": season,
                                "episode": episode,
                                "path": full_path,
                                "thumbnail": f"https://picsum.photos/seed/{file}/300/170"
                            })
                        else:
                            movies.append({
                                "title": file,
                                "path": full_path,
                                "year": "2023",
                                "actors": "Main Cast",
                                "description": f"Scanned from {os.path.basename(base_dir)}",
                                "thumbnail": f"https://picsum.photos/seed/{file}/300/450"
                            })

    return {"movies": movies, "tv_shows": tv_shows}

